# ============================================================
# DeepFish 配置模板
#
# 用法：把这个文件复制一份，改名成 .env，把密钥填上，存盘即可 ——
# 不用重启服务器，刷新一下页面就生效（见下面那条说明）。
#
#   在项目根目录敲：  copy .env.example .env       （Windows）
#                    cp .env.example .env         （macOS / Linux）
#
# ⚠️ 为什么密钥要放在 .env 里，而不是直接写进代码？
#    因为代码迟早会被看到（发给别人、传上 GitHub、随手贴群里），
#    而 .env 已经被 .gitignore 挡在版本库外面，不会跟着代码跑出去。
#    把密钥和代码分开，是这件事唯一正确的位置。
#
# ✅ 改完**不用**重启：llm.js 每次请求都会先看一眼 .env 的修改时间，
#    文件变了就重新读一遍（见 src/llm.js 里 loadEnvFile 的说明）。
#    所以"填好密钥 → 保存 → 刷新页面"就能用。
#    例外是**启动时才会看的**那几个：PORT（服务器端口）、
#    SF_THREADS / SF_HASH（引擎在模块加载时读一次）—— 这几个改了要重启。
# ============================================================

# ---------- DeepSeek：负责讲棋 ----------

# 【必填】你的 API 密钥。
# 申请地址：https://platform.deepseek.com/api_keys
# 长得像：sk-1234567890abcdefghijklmnopqrstuv
# 注意：只要 sk- 后面那一整串，前后不要加引号、不要留空格。
DEEPSEEK_API_KEY=

# 接口地址。国内直连就用下面这个，不用改。
# 如果走代理或有自己的中转服务，改成对应地址（通常填到 /v1 为止）。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 用哪个模型：
#   deepseek-chat      快、便宜，讲棋完全够用 —— 默认用这个
#   deepseek-reasoner  会先在心里推演一遍再回答，讲得也许更透，但慢些、贵些
DEEPSEEK_MODEL=deepseek-chat

# 单次请求最多等多久（毫秒）。讲一段话比算一步棋慢，所以给了 60 秒。
DEEPSEEK_TIMEOUT_MS=60000

# 碰到限流、对方服务器出错、网络抖动时，最多自动重试几次。
# 密钥错误、余额不足这类问题不会重试 —— 重试一百次也还是不行。
DEEPSEEK_MAX_RETRIES=2

# 发挥程度：0 = 每次措辞都差不多，1 = 更灵活。
# 讲棋不需要死板，0.7 比较合适。
DEEPSEEK_TEMPERATURE=0.7

# 回复长度上限。太小会讲到一半被截断。
DEEPSEEK_MAX_TOKENS=1200

# ---------- Stockfish：负责算棋 ----------

# 引擎文件的位置。留空就用项目里 stockfish/ 目录下的那个。
# STOCKFISH_PATH=

# 思考用几个线程、多少内存。自己一个人用，2 线程 128MB 已经很快了。
# 调大能算得更快，但会和别的程序抢 CPU。
SF_THREADS=2
SF_HASH=128

# 单次分析最多算多久（毫秒），超时就强制收工。
SF_TIMEOUT=30000

# ---------- 服务器 ----------

# 想换端口就取消下面这行的注释
# PORT=3000
